{
  "mcp": {
    "toolMode": "proxy",
    "startup": "lazy",
    "servers": {
      "cf-portal": {
        "type": "remote",
        "url": "https://portal.mcp.cfdata.org/mcp?codemode=search_and_execute",
        "oauth": {}
      },
      "uidotsh": {
        "type": "remote",
        "url": "https://ui.sh/mcp?agent=pi",
        "headers": {
          "Authorization": "Bearer ${UIDOTSH_TOKEN}"
        },
        "oauth": false
      },
      "open-computer-use": {
        "type": "local",
        "command": ["open-computer-use", "mcp"],
        "enabled": true,
        "timeout": 60000
      },
      "atlassian": {
        "type": "remote",
        "url": "https://mcp.atlassian.com/v1/mcp/authv2",
        "oauth": {}
      },
      "deepwiki": {
        "type": "remote",
        "url": "https://mcp.deepwiki.com/mcp",
        "oauth": false
      },
      "freshservice": {
        "type": "local",
        "command": ["mcp-remote", "https://${FRESHSERVICE_DOMAIN}/mcp"],
        "enabled": true
      },
      "linear": {
        "type": "remote",
        "url": "https://mcp.linear.app/mcp",
        "oauth": {}
      }
    }
  }
}
