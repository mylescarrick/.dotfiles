{
  "name": ".pi",
  "private": true,
  "type": "module",
  "workspaces": ["agent/extensions/*"],
  "scripts": {
    "check": "bun run --cwd agent/extensions/save-md check && bun run --cwd agent/extensions/web-tools check && bun run --cwd agent/extensions/output-style check",
    "test:codex-fast-mode": "node --import tsx --test tests/codex-fast-mode.test.ts",
    "test:save-md": "bun run --cwd agent/extensions/save-md test",
    "test:web-tools": "bun run --cwd agent/extensions/web-tools test"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "^1.3.15"
  },
  "packageManager": "bun@1.3.14"
}
